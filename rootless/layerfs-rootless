#!/usr/bin/env python3
import argparse
import contextlib
import fcntl
import os
from pathlib import Path
import select
import shutil
import signal
import socket
import subprocess
import sys
import tempfile


def arguments():
    parser = argparse.ArgumentParser(
        description="Run LayerFS in an unprivileged User-Mode Linux guest."
    )
    sub = parser.add_subparsers(dest="operation", required=True)
    init = sub.add_parser(
        "init", help="import a source directory into a new project disk"
    )
    init.add_argument("disk", type=Path)
    init.add_argument("source", type=Path)
    run = sub.add_parser(
        "run", help="run a command in a Workspace and commit on success"
    )
    run.add_argument("--branch", default="work", help="branch to mount (default: work)")
    run.add_argument("disk", type=Path)
    run.add_argument("command", nargs=argparse.REMAINDER)
    call = sub.add_parser(
        "call", help="invoke a direct Store method with JSON arguments"
    )
    call.add_argument("disk", type=Path)
    call.add_argument("method")
    call.add_argument("arguments", metavar="JSON")
    session = sub.add_parser(
        "session", help="stream Store calls and Workspace runs through one guest"
    )
    session.add_argument("disk", type=Path)
    task = sub.add_parser(
        "task", help="execute commands in one explicitly finished Workspace"
    )
    task.add_argument("--branch", default="work")
    task.add_argument("disk", type=Path)
    args = parser.parse_args()
    if args.operation == "run":
        if args.command[:1] == ["--"]:
            args.command = args.command[1:]
        if not args.command or not args.command[0]:
            parser.error("run requires a command")
    return args


def workspace_reply(request, index, code):
    # Stream binary output as JSON without a command-output-sized allocation.
    sink = sys.stdout.buffer
    sink.write(b'{"exit":' + code)
    for name in ("stdout", "stderr"):
        path = request / f"{index}.{name}"
        sink.write(b',"' + name.encode() + b'":{"$bytes":"')
        with path.open("rb") as stream:
            for chunk in iter(lambda: stream.read(64 * 1024), b""):
                sink.write(chunk.hex().encode())
        sink.write(b'"}')
        path.unlink()
    sink.write(b"}\n")
    (request / f"{index}.stdin").unlink()


def serve(channel, request, task=False):
    if channel.recv(1) != b"R":
        return False
    active = False

    def receive():
        # An abandoned client can close stdout while a silent command is running.
        if task:
            for fd, events in watcher.poll():
                if fd == sys.stdout.fileno():
                    raise BrokenPipeError("task client closed its reply stream")
        return channel.recv(1)

    if task:
        watcher = select.poll()
        watcher.register(channel, select.POLLIN)
        watcher.register(sys.stdout, 0)

        def cancel(signum, frame):
            if active:
                channel.sendall(b"A")

        signal.signal(signal.SIGUSR1, cancel)
        print('{"ready":true}', flush=True)
    for index, line in enumerate(sys.stdin.buffer):
        payload = request / f"{index}.in"
        reply = request / f"{index}.out"
        payload.write_bytes(line)
        channel.sendall(b"C")
        active = True
        if task:
            print('{"running":true}', flush=True)
        status = receive()
        while status == b"S" and task:
            chunk = request / f"{index}.chunk"
            print('{"data":"' + chunk.read_bytes().hex() + '"}', flush=True)
            chunk.unlink()
            channel.sendall(b"Y")
            status = receive()
        active = False
        if status == b"T":
            return True  # Terminal outcome follows guest shutdown.
        if status not in (b"D", b"E", b"W", b"F"):
            return False
        if status in (b"W", b"F"):
            workspace_reply(request, index, reply.read_bytes())
        else:
            with reply.open("rb") as stream:
                shutil.copyfileobj(stream, sys.stdout.buffer)
        sys.stdout.buffer.flush()
        payload.unlink()
        reply.unlink()
        if status in (b"E", b"F"):
            return True
    channel.sendall(b"Q")
    return True


def boot(bundle, disk, disk_fd, request, args):
    # Short, constant block-device paths also work when user paths contain commas.
    for name in ("lib", "root.ext4"):
        (request / name).symlink_to(bundle / name)
    (request / "project.ext4").symlink_to(disk)
    if args.operation == "init":
        (request / "source").symlink_to(args.source.resolve(strict=True))
        command = ["init"]
    elif args.operation == "task":
        command = ["task", args.branch]
    elif args.operation == "session":
        command = ["session"]
    elif args.operation == "call":
        command = ["call", args.method, args.arguments]
    else:
        command = ["run", args.branch, "--", *args.command]
    (request / "argv").write_bytes(
        b"".join(os.fsencode(arg) + b"\0" for arg in command)
    )
    with (request / "stdin").open("wb") as sink:
        if args.operation == "run" and not sys.stdin.isatty():
            shutil.copyfileobj(sys.stdin.buffer, sink)
    env = dict(
        HOME=str(request),
        TMPDIR=str(request),
        LC_ALL="C",
        LD_LIBRARY_PATH="lib",
        PATH="/usr/bin:/bin",
    )
    kernel = [
        bundle / "linux.uml",
        "seccomp=on",
        "mem=512M",
        "umid=layerfs",
        "ubd0r=root.ext4",
        "ubd1=project.ext4",
        "root=98:0",
        "ro",
        "init=/init",
        "con=null",
        "con0=fd:0,fd:1",
    ]
    confirmed = True
    with (request / "boot.log").open("wb") as log:
        options = dict(
            cwd=request,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
        )
        if args.operation in ("session", "task"):
            host, guest = socket.socketpair()
            with host, guest:
                fd = guest.fileno()
                kernel.append(f"ssl0=fd:{fd},fd:{fd}")
                with subprocess.Popen(
                    kernel, pass_fds=(disk_fd, fd), **options
                ) as result:
                    guest.close()
                    try:
                        confirmed = serve(host, request, args.operation == "task")
                    except (BrokenPipeError, KeyboardInterrupt):
                        if args.operation == "task":
                            host.sendall(b"Q")
                        raise
                    finally:
                        host.close()
        else:
            result = subprocess.run(kernel, pass_fds=(disk_fd,), **options)
    for name, sink in (("stdout", sys.stdout.buffer), ("stderr", sys.stderr.buffer)):
        if (request / name).exists():
            with (request / name).open("rb") as stream:
                shutil.copyfileobj(stream, sink)
            sink.flush()
    status = request / "status"
    if result.returncode or not status.is_file():
        with (request / "boot.log").open("rb") as stream:
            shutil.copyfileobj(stream, sys.stderr.buffer)
        raise RuntimeError(
            "UML stopped without a clean guest shutdown; inspect the project before retrying"
        )
    code = int(status.read_text().strip())
    if not confirmed and code == 0:
        raise RuntimeError(
            "session ended without confirming its reply; inspect the project before retrying"
        )
    return code


def main():
    args = arguments()
    bundle = Path(__file__).resolve().parent
    disk = args.disk.absolute()
    creating = args.operation == "init"
    if creating:
        src = args.source.resolve(strict=True)
        if not src.is_dir():
            raise ValueError("source must be a directory")
        temp = Path(tempfile.gettempdir()).resolve()
        if src in disk.resolve().parents or temp == src or src in temp.parents:
            raise ValueError(
                "keep the project disk and TMPDIR outside the imported directory"
            )
    flags = os.O_RDWR | (os.O_CREAT | os.O_EXCL if creating else 0)
    with contextlib.ExitStack() as stack:
        fd = os.open(disk, flags, 0o600)
        stack.callback(os.close, fd)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("another invocation owns this project disk") from None
        if creating:
            subprocess.run(
                ["cp", "--sparse=always", "--", bundle / "empty.ext4", disk], check=True
            )
        with tempfile.TemporaryDirectory(prefix="layerfs-") as directory:
            return boot(bundle, disk, fd, Path(directory).resolve(), args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(f"layerfs-rootless: {error}")
